{
  "name": "territorio-app",
  "version": "0.12.74",
  "description": "Território — vendas, estoque e eventos para produtores rurais (Android).",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "icons": "node tools/make-icons.mjs",
    "sync": "vite build && cap sync android",
    "apk:debug": "npm run sync && cd android && gradlew.bat assembleDebug",
    "aab:release": "npm run sync && cd android && gradlew.bat bundleRelease"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/app-launcher": "8.0.1",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/inter-tight": "5.3.0",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "sharp": "0.35.5",
    "vite": "8.3.4"
  }
}
