{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "reference",
    "clarify",
    "tasks"
  ],
  "properties": {
    "type": {
      "enum": [
        "query",
        "hypothesis",
        "clarify"
      ],
      "type": "string"
    },
    "reference": {
      "enum": [
        "explicit",
        "previous",
        "ambiguous"
      ],
      "type": "string"
    },
    "clarify": {
      "enum": [
        "none",
        "entity",
        "product",
        "supplier",
        "client",
        "event",
        "period",
        "metric",
        "missing_cost",
        "unsupported"
      ],
      "type": "string"
    },
    "tasks": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "filter",
          "ids",
          "period"
        ],
        "properties": {
          "kind": {
            "enum": [
              "stock",
              "stock_empty",
              "entries",
              "sold",
              "ranking_qty",
              "ranking_profit",
              "finance",
              "pending",
              "purchases",
              "clients",
              "cnpjs",
              "customer",
              "events",
              "weather",
              "discount"
            ],
            "type": "string"
          },
          "filter": {
            "enum": [
              "none",
              "product",
              "supplier",
              "client",
              "event"
            ],
            "type": "string"
          },
          "ids": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "maxLength": 100
            }
          },
          "period": {
            "enum": [
              "selected",
              "today",
              "tomorrow",
              "yesterday",
              "month",
              "previous_month",
              "all"
            ],
            "type": "string"
          },
          "discountCents": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
